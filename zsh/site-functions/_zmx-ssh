#compdef zmx-ssh

## Completes ssh hosts first, then the zmx sessions running on the chosen host.
##
## The session probe only runs when a ControlMaster socket for that host is
## already up (`ssh -O check`).  Without that guard, tabbing after a cold host
## would open a fresh connection and hang the prompt until it finished.

_zmx-ssh() {
  local curcontext="$curcontext" state line ret=1
  typeset -A opt_args

  _arguments -C \
    '(-r --reconnect)'{-r,--reconnect}'[choose from the sessions already running on the host]' \
    '1: :->host' \
    '2: :->session' \
    && ret=0

  case $state in
    host)
      ## Same source as the ssh completion, so ssh_config Host aliases and
      ## known_hosts entries both show up.
      _ssh_hosts && ret=0
      ;;
    session)
      local host=${line[1]}
      local -a sessions

      ## zmx reads its socket directory from TMPDIR, which ~/.profile sets, so
      ## the probe has to source the profile exactly as the wrapper does or it
      ## looks in the wrong place and reports nothing.
      if [[ -n $host ]] && ssh -O check "$host" >/dev/null 2>&1; then
        sessions=(${(f)"$(ssh -o BatchMode=yes "$host" \
          'if ! command -v zmx >/dev/null 2>&1; then
             [ -r "$HOME/.profile" ] && . "$HOME/.profile"
           fi
           zmx ls --short' 2>/dev/null)"})
      fi

      ## Returning through an _arguments `->state` leaves no _tags loop
      ## running, so anything that requests a tag on its own adds nothing:
      ## _describe stays silent and _alternative drops the sessions.  _wanted
      ## sets the loop up itself and is the only form that works here.
      if (( ${#sessions} )); then
        _wanted zmx-sessions expl 'zmx session' compadd -a sessions && ret=0
      fi

      ## _arguments only volunteers options once the word starts with a dash,
      ## and on a host with no sessions yet --reconnect is the only useful
      ## completion left, so offer the flags here too.
      _wanted options expl 'option' compadd -- -r --reconnect && ret=0
      ;;
  esac

  return ret
}

_zmx-ssh "$@"
