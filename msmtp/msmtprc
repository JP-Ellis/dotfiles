# msmtp configuration
# See: https://marlam.de/msmtp/msmtp.html

defaults
logfile ~/.msmtp.log

# MARK: jpellis LAN relay
# OpenSMTPD on the home network (media.jpellis.me).
# Plain port 25, no auth or TLS advertised.
account jpellis
host media.jpellis.me
port 25
from {{email}}
auth off
tls off

account default : jpellis
