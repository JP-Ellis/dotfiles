[Unit]
Description=rustic backup (home)
# The repository lives on an autofs direct mount. Probing its config triggers the
# automount, and yields ENOENT rather than blocking when the NAS is unreachable,
# so an offline NAS skips the run instead of failing it.
ConditionPathExists={{rustic-repository}}/config

[Service]
Type=oneshot

# Bound the run so a wedged NFS handle cannot hold the unit active forever.
TimeoutStartSec=3h

# Lower CPU and I/O priority to keep backups clear of interactive work.
Nice=19
CPUSchedulingPolicy=batch
IOSchedulingClass=best-effort
IOSchedulingPriority=7
IOWeight=100

Restart=no
# Run through rustic-scheduled for the repository-wide lock, which keeps this
# clear of a prune or check running on another machine.
ExecStart=%h/.local/bin/rustic-scheduled backup
