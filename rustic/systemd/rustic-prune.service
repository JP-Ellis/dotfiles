[Unit]
Description=rustic retention and prune (home)
ConditionPathExists={{rustic-repository}}/config
# forget and prune rewrite the index, so they must not overlap a backup. The lock
# in rustic-scheduled keeps them apart on every machine. Conflicts= is avoided:
# systemd applies it both ways, so a backup timer firing mid-prune would stop
# the prune partway through a repack.
After=rustic-backup.service

[Service]
Type=oneshot

TimeoutStartSec=6h

Nice=19
CPUSchedulingPolicy=batch
IOSchedulingClass=best-effort
IOSchedulingPriority=7
IOWeight=100

Restart=no
# Retention comes from the [forget] table in rustic.toml, scoped to this host.
ExecStart=%h/.local/bin/rustic-scheduled forget --prune
