<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>me.jpellis.rustic-backup</string>

  <!-- The launcher holds the privacy grants and runs rustic-scheduled,
       which supplies what launchd cannot: the repository guard, the
       cross-job lock, and the battery back-off. -->
  <key>ProgramArguments</key>
  <array>
    <string>{{rustic-home}}/Applications/RusticScheduled.app/Contents/MacOS/rustic-scheduled</string>
    <string>backup</string>
  </array>

  <!-- Fires every 20 minutes. On battery the wrapper drops this to hourly. -->
  <key>StartInterval</key>
  <integer>1200</integer>

  <key>Nice</key>
  <integer>19</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>LowPriorityIO</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/tmp/me.jpellis.rustic-backup.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/me.jpellis.rustic-backup.log</string>
</dict>
</plist>
