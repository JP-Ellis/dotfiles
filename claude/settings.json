{
  "env": {
    "CLAUDE_MODEL": "claude-sonnet-4-6"
  },
  "attribution": {
    "commit": "Assisted-by: Claude Code:{{claude:model}}",
    "pr": ""
  },
  "permissions": {
    "allow": ["Read(~/.claude/plugins/cache/claude-plugins-official/)"],
    "deny": [
      "Bash(rtk cargo * --message-format=*)",
      "Bash(git add -A)",
      "Bash(rtk git add -A)"
    ],
    "defaultMode": "auto"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      }
    ]
  },
  "allowManagedMcpServersOnly": false,
  "enabledPlugins": {
    "code-review@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": false,
    "feature-dev@claude-plugins-official": false,
    "playwright@claude-plugins-official": false,
    "pyright-lsp@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "ruby-lsp@claude-plugins-official": true,
    "datadog@claude-plugins-official": true,
    "slack@claude-plugins-official": false,
    "github@claude-plugins-official": true
  },
  "effortLevel": "medium",
  "tui": "fullscreen",
  "skipWorkflowUsageWarning": true,
  "theme": "auto",
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "skillOverrides": {
    "cloudflare": "user-invocable-only",
    "cloudflare-email-service": "user-invocable-only",
    "durable-objects": "user-invocable-only",
    "web-perf": "user-invocable-only",
    "workers-best-practices": "user-invocable-only",
    "wrangler": "user-invocable-only",
    "agents-sdk": "user-invocable-only",
    "sandbox-sdk": "user-invocable-only"
  }
}
