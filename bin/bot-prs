#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.12"
# dependencies = ["prompt-toolkit>=3.0", "questionary>=2.0", "rich>=13.0"]
# ///
"""Approve and merge Renovate and Dependabot pull requests in bulk.

Lists every open bot pull request across the configured owners, groups them by
dependency or by repository, and approves plus auto-merges whichever ones are
selected.
"""

from __future__ import annotations

import argparse
import base64
import json
import random
import re
import shutil
import subprocess
import sys
import threading
import time
import webbrowser
from collections.abc import Callable
from concurrent.futures import ThreadPoolExecutor, as_completed
from dataclasses import dataclass, field
from typing import Any

import questionary
from prompt_toolkit.filters import Condition
from prompt_toolkit.layout import (
    ConditionalContainer,
    Float,
    FloatContainer,
    Layout,
    Window,
)
from prompt_toolkit.layout.controls import FormattedTextControl
from prompt_toolkit.widgets import Frame
from questionary.prompts.common import InquirerControl
from rich.console import Console
from rich.progress import (
    BarColumn,
    MofNCompleteColumn,
    Progress,
    TaskProgressColumn,
    TextColumn,
    TimeElapsedColumn,
    TimeRemainingColumn,
)
from rich.table import Table

# MARK: Configuration

OWNERS = ("JP-Ellis", "pactflow", "pact-foundation")
BOT_AUTHORS = ("app/renovate", "app/dependabot", "app/pactflow-renovate-bot")

# Merge methods in the order they are tried, paired with the repository field
# that says whether the method is available.
MERGE_METHODS = (
    ("rebaseMergeAllowed", "--rebase"),
    ("squashMergeAllowed", "--squash"),
    ("mergeCommitAllowed", "--merge"),
)

# Update kinds that are pre-selected. Anything else — a major bump or an
# unrecognised update — has to be ticked by hand.
AUTO_SELECT_BUMPS = frozenset({"minor", "patch", "pin", "digest", "lockfile"})

# Most to least severe, for picking one kind out of a multi-package update.
BUMP_SEVERITY = (
    "major",
    "minor",
    "patch",
    "pin",
    "digest",
    "lockfile",
    "rollback",
)

# Search pages are fetched in parallel by computing the cursor for each offset.
# GitHub's search cursors are base64 of "cursor:<offset>", which is undocumented
# but has been stable for years. Small pages keep each request well under
# GitHub's ~10 s GraphQL deadline, which larger pages hit when run concurrently.
# The search API returns at most 1000 results.
PAGE_SIZE = 25
SEARCH_LIMIT = 1000
FETCH_WORKERS = 16
FETCH_RETRIES = 2
TIMED_OUT = re.compile(r"couldn't respond to your request in time|timeout", re.IGNORECASE)

GRAPHQL = """
query($q: String!, $first: Int!, $after: String) {
  viewer { login }
  search(query: $q, type: ISSUE, first: $first, after: $after) {
    issueCount
    nodes {
      ... on PullRequest {
        number
        title
        url
        body
        mergeable
        autoMergeRequest { enabledAt }
        labels(first: 20) { nodes { name } }
        repository {
          nameWithOwner
          autoMergeAllowed
          rebaseMergeAllowed
          squashMergeAllowed
          mergeCommitAllowed
        }
        reviews(last: 20) { nodes { state author { login } } }
        commits(last: 1) { nodes { commit { statusCheckRollup { state } } } }
      }
    }
  }
}
"""

console = Console()


# MARK: Data


@dataclass
class PullRequest:
    repo: str
    number: int
    title: str
    url: str
    ci: str
    mergeable: str
    bump: str
    group: str
    approved: bool
    auto_merge: bool
    merge_flags: list[str] = field(default_factory=list)
    auto_merge_allowed: bool = False

    @property
    def failing(self) -> bool:
        return self.ci in {"FAILURE", "ERROR"} or self.mergeable == "CONFLICTING"

    @property
    def default_selected(self) -> bool:
        return self.bump in AUTO_SELECT_BUMPS and not self.failing


# MARK: GitHub


def gh(*args: str) -> subprocess.CompletedProcess[str]:
    return subprocess.run(["gh", *args], capture_output=True, text=True, check=False)


def cursor(offset: int) -> str:
    return base64.b64encode(f"cursor:{offset}".encode()).decode()


def fetch(
    owners: tuple[str, ...], progress: Callable[[int, int], None]
) -> tuple[str, list[dict]]:
    """Return the viewer's login and every open bot pull request."""
    query = " ".join(
        [
            "is:pr",
            "is:open",
            "draft:false",
            "archived:false",
            *(f"author:{bot}" for bot in BOT_AUTHORS),
            *(f"owner:{owner}" for owner in owners),
            # A fixed order keeps pages disjoint while they are fetched at once.
            "sort:created-asc",
        ]
    )

    def page(offset: int) -> dict:
        cmd = [
            "api",
            "graphql",
            "-f",
            f"query={GRAPHQL}",
            "-f",
            f"q={query}",
            "-F",
            f"first={PAGE_SIZE}",
        ]
        if offset:
            cmd += ["-f", f"after={cursor(offset)}"]
        for _attempt in range(FETCH_RETRIES + 1):
            result = gh(*cmd)
            if result.returncode == 0:
                return json.loads(result.stdout)["data"]
            if not TIMED_OUT.search(result.stderr):
                break
        console.print(f"[red]gh api graphql failed:[/red] {result.stderr.strip()}")
        sys.exit(1)

    first = page(0)
    viewer = first["viewer"]["login"]
    total = first["search"]["issueCount"]
    if total > SEARCH_LIMIT:
        console.print(
            f"[yellow]{total} matching pull requests, but GitHub search only"
            f" returns the first {SEARCH_LIMIT}.[/yellow]"
        )
        total = SEARCH_LIMIT

    by_url: dict[str, dict] = {}

    def collect(data: dict) -> None:
        for node in data["search"]["nodes"]:
            if node:
                by_url[node["url"]] = node
        progress(len(by_url), total)

    collect(first)
    with ThreadPoolExecutor(max_workers=FETCH_WORKERS) as pool:
        futures = [
            pool.submit(page, offset) for offset in range(PAGE_SIZE, total, PAGE_SIZE)
        ]
        for future in as_completed(futures):
            collect(future.result())
    return viewer, list(by_url.values())


# MARK: Classification

CONVENTIONAL = re.compile(r"^\w+(\([^)]*\))?!?:\s*")
VERSION_PAIR = re.compile(
    r"`[^`0-9]*([0-9][^`]*)`\s*(?:->|→|=>)\s*`[^`0-9]*([0-9][^`]*)`"
)
BUMP_TITLE = re.compile(r"\bfrom\s+v?([0-9][\w.+-]*)\s+to\s+v?([0-9][\w.+-]*)", re.IGNORECASE)
LABEL_BUMP = re.compile(r"^(?:semver[-_]?)?(major|minor|patch)$", re.IGNORECASE)
TRAILING_VERSION = re.compile(
    r"(\s+from\s+\S+\s+to\s+\S+|\s+to\s+v?[0-9]\S*|\s+to\s+[0-9a-f]{7,40})$", re.IGNORECASE
)
TRAILING_PATH = re.compile(r"\s+in\s+/\S*$", re.IGNORECASE)


def cells(line: str) -> list[str]:
    """The cells of a markdown table row, lowercased."""
    return [cell.strip().lower() for cell in line.strip().strip("|").split("|")]


def table_bumps(body: str) -> list[str]:
    """The Update column of Renovate's package table, one entry per package."""
    lines = body.splitlines()
    for index, line in enumerate(lines):
        header = cells(line)
        if "update" not in header or "package" not in header:
            continue

        column = header.index("update")
        updates = []
        for row in lines[index + 2 :]:
            if not row.strip().startswith("|"):
                break
            values = cells(row)
            if len(values) > column:
                updates.append(
                    values[column].replace("lockfilemaintenance", "lockfile")
                )
        return updates
    return []


def components(version: str) -> list[int]:
    """The leading numeric components of a version, as far as they parse."""
    parts: list[int] = []
    for chunk in re.split(r"[.\-+]", version):
        match = re.match(r"^(\d+)", chunk)
        if not match:
            break
        parts.append(int(match.group(1)))
    return (parts + [0, 0, 0])[:3]


def bump_type(node: dict) -> str:
    """Classify an update by severity, falling back to comparing versions."""
    for label in node["labels"]["nodes"]:
        if match := LABEL_BUMP.match(label["name"].strip()):
            return match.group(1).lower()

    body = node["body"] or ""
    known = [kind for kind in table_bumps(body) if kind in BUMP_SEVERITY]
    if known:
        return min(known, key=BUMP_SEVERITY.index)

    pair = BUMP_TITLE.search(node["title"]) or VERSION_PAIR.search(body)
    if not pair:
        return "unknown"

    old, new = components(pair.group(1)), components(pair.group(2))
    if old[0] != new[0]:
        return "major"
    if old[1] != new[1]:
        return "minor"
    return "patch"


def group_key(title: str) -> str:
    """A dependency identity that ignores the version being moved to."""
    stripped = CONVENTIONAL.sub("", title).strip().lower()
    return TRAILING_VERSION.sub("", TRAILING_PATH.sub("", stripped)).strip()


def build(node: dict, viewer: str) -> PullRequest:
    repo = node["repository"]
    commits = node["commits"]["nodes"]
    rollup = commits[0]["commit"]["statusCheckRollup"] if commits else None

    return PullRequest(
        repo=repo["nameWithOwner"],
        number=node["number"],
        title=CONVENTIONAL.sub("", node["title"]).strip(),
        url=node["url"],
        ci=rollup["state"] if rollup else "NONE",
        mergeable=node["mergeable"],
        bump=bump_type(node),
        group=group_key(node["title"]),
        approved=any(
            review["state"] == "APPROVED"
            and (review["author"] or {}).get("login") == viewer
            for review in node["reviews"]["nodes"]
        ),
        auto_merge=node["autoMergeRequest"] is not None,
        merge_flags=[flag for field_, flag in MERGE_METHODS if repo[field_]],
        auto_merge_allowed=repo["autoMergeAllowed"],
    )


# MARK: Selection

CI_MARKS = {
    "SUCCESS": ("✓", "ci-pass"),
    "PENDING": ("●", "ci-pending"),
    "EXPECTED": ("●", "ci-pending"),
    "FAILURE": ("✗", "ci-fail"),
    "ERROR": ("✗", "ci-fail"),
    "NONE": ("·", "dim"),
}

STYLE = questionary.Style(
    [
        ("ci-pass", "fg:#28a745"),
        ("ci-pending", "fg:#d4a017"),
        ("ci-fail", "fg:#d73a49 bold"),
        ("bump-major", "fg:#d18616 bold"),
        ("bump-other", "fg:#6a737d"),
        ("dim", "fg:#6a737d"),
        ("separator", "fg:#6a737d bold"),
        ("frame.border", "fg:#6a737d"),
        ("help-key", "fg:#0366d6 bold"),
    ]
)

KEYS = (
    ("↑ ↓ / k j", "move"),
    ("space", "tick or untick, then move down"),
    ("a", "tick or untick everything"),
    ("i", "invert every tick"),
    ("n", "untick everything"),
    ("o", "open the highlighted pull request in the browser"),
    ("h", "hide every pull request from the highlighted repository"),
    ("u", "unhide every hidden repository"),
    ("s", "group by dependency or by repository"),
    ("zt zz zb", "put the highlighted row at the top, centre, or bottom"),
    ("?", "show or hide this help"),
    ("enter", "approve and merge the ticked pull requests"),
    ("ctrl-c", "abort"),
)


def help_text() -> list[tuple[str, str]]:
    width = max(len(key) for key, _ in KEYS)
    lines: list[tuple[str, str]] = []
    for index, (key, description) in enumerate(KEYS):
        lines.append(("class:help-key", f"{key:>{width}}"))
        lines.append(("", f"  {description}" + ("\n" if index < len(KEYS) - 1 else "")))
    return lines


def customise(
    question: questionary.Question, rows: list[Row], widths: tuple[int, int]
) -> None:
    """Add the help overlay and the untick, browser, and hide-repository keys."""
    app = question.application
    control = next(
        c for c in app.layout.find_all_controls() if isinstance(c, InquirerControl)
    )
    app.show_help = False

    app.layout = Layout(
        FloatContainer(
            content=app.layout.container,
            floats=[
                Float(
                    ConditionalContainer(
                        Frame(Window(FormattedTextControl(help_text)), title="keys"),
                        filter=Condition(lambda: app.show_help),
                    )
                )
            ],
        )
    )

    bindings = app.key_bindings

    @bindings.add("?", eager=True)
    def _toggle_help(_event):
        app.show_help = not app.show_help

    @bindings.add("n", eager=True)
    def _untick_all(_event):
        control.selected_options.clear()

    @bindings.add(" ", eager=True)
    def _toggle_and_advance(_event):
        """Tick or untick, then step to the next row so a run of rows can be
        toggled by holding space. Stops on the last row instead of wrapping."""
        value = control.get_pointed_at().value
        if value in control.selected_options:
            control.selected_options.remove(value)
        else:
            control.selected_options.append(value)

        rows_below = range(control.pointed_at + 1, len(control.choices))
        control.pointed_at = next(
            (
                i
                for i in rows_below
                if not isinstance(control.choices[i], questionary.Separator)
            ),
            control.pointed_at,
        )

    @bindings.add("o", eager=True)
    def _open(_event):
        pointed = control.get_pointed_at()
        if isinstance(pointed.value, PullRequest):
            webbrowser.open(pointed.value.url)

    hidden: set[str] = set()
    mode = 0

    def rebuild() -> None:
        pointed = control.get_pointed_at().value
        control.choices = listing(rows, hidden, widths, mode)
        control.selected_options[:] = [
            value
            for value in control.selected_options
            if not (isinstance(value, PullRequest) and value.repo in hidden)
        ]

        # Follow the highlighted pull request to wherever it moved to, falling
        # back to the row it used to sit on once it is hidden.
        index = next(
            (
                i
                for i, entry in enumerate(control.choices)
                if not isinstance(entry, questionary.Separator)
                and entry.value is pointed
            ),
            min(control.pointed_at, len(control.choices) - 1),
        )

        # Land the cursor on the nearest row that is not a group header.
        order = [*range(index, len(control.choices)), *range(index - 1, -1, -1)]
        control.pointed_at = next(
            (
                i
                for i in order
                if not isinstance(control.choices[i], questionary.Separator)
            ),
            index,
        )

    @bindings.add("h", eager=True)
    def _hide(_event):
        pointed = control.get_pointed_at()
        if not isinstance(pointed.value, PullRequest):
            return

        # Hiding the last visible repository would leave nothing to point at.
        candidate = hidden | {pointed.value.repo}
        if any(pr.repo not in candidate for pr, _ in rows):
            hidden.add(pointed.value.repo)
            rebuild()

    @bindings.add("u", eager=True)
    def _unhide(_event):
        hidden.clear()
        rebuild()

    @bindings.add("s", eager=True)
    def _regroup(_event):
        nonlocal mode
        mode = 1 - mode
        rebuild()

    window = next(
        w for w in app.layout.walk() if isinstance(w, Window) and w.content is control
    )

    def scroll(line: Callable[[int], int]) -> None:
        """Put the highlighted row on the line the callback picks."""
        info = window.render_info
        if info is None:
            return
        limit = max(0, len(control.choices) - info.window_height)
        window.vertical_scroll = max(0, min(line(info.window_height), limit))

    @bindings.add("z", "t")
    def _to_top(_event):
        scroll(lambda _height: control.pointed_at)

    @bindings.add("z", "z")
    def _to_centre(_event):
        scroll(lambda height: control.pointed_at - height // 2)

    @bindings.add("z", "b")
    def _to_bottom(_event):
        scroll(lambda height: control.pointed_at - height + 1)


def title(pr: PullRequest, repo_width: int, title_width: int, indent: bool) -> list[Any]:
    mark, mark_style = CI_MARKS.get(pr.ci, ("?", "dim"))
    if pr.mergeable == "CONFLICTING":
        mark, mark_style = "⚠", "ci-fail"

    width = title_width - (2 if indent else 0)
    text = pr.title if len(pr.title) <= width else pr.title[: width - 1] + "…"
    slug = f"{pr.repo}#{pr.number}"

    return [
        ("", "  " if indent else ""),
        (f"class:{mark_style}", f"{mark} "),
        (
            "class:bump-major" if pr.bump == "major" else "class:bump-other",
            f"{pr.bump:<9}",
        ),
        ("class:dim", f"{slug:<{repo_width}}  "),
        ("", text),
    ]


def choice(pr: PullRequest, repo_width: int, title_width: int) -> questionary.Choice:
    return questionary.Choice(
        title=title(pr, repo_width, title_width, indent=False),
        value=pr,
        checked=pr.default_selected,
    )


Row = tuple[PullRequest, questionary.Choice]


@dataclass(frozen=True)
class Ordering:
    """How the listing groups its rows: header key, row order, and a name."""

    key: Callable[[PullRequest], str]
    sort: Callable[[PullRequest], tuple]
    name: str


ORDERINGS = (
    Ordering(
        key=lambda pr: pr.group,
        sort=lambda pr: (pr.group, pr.repo, pr.number),
        name="dependency",
    ),
    Ordering(
        key=lambda pr: pr.repo,
        sort=lambda pr: (pr.repo, pr.group, pr.number),
        name="repository",
    ),
)


def listing(
    rows: list[Row], hidden: set[str], widths: tuple[int, int], mode: int
) -> list[Any]:
    """The visible rows, with each repeated key indented under a header."""
    ordering = ORDERINGS[mode]
    visible = sorted(
        (row for row in rows if row[0].repo not in hidden),
        key=lambda row: ordering.sort(row[0]),
    )

    counts: dict[str, int] = {}
    for pr, _ in visible:
        counts[ordering.key(pr)] = counts.get(ordering.key(pr), 0) + 1

    choices: list[Any] = [
        questionary.Separator(
            f"  by {ordering.name} — s to group by {ORDERINGS[1 - mode].name}"
        )
    ]
    if hidden:
        plural = "repository" if len(hidden) == 1 else "repositories"
        choices.append(
            questionary.Separator(f"  {len(hidden)} {plural} hidden — u to unhide")
        )

    current = None
    grouped = False
    for pr, entry in visible:
        key = ordering.key(pr)
        block = counts[key] > 1
        if key != current:
            first = current is None
            current = key
            # A blank line closes the block above, so that the rows following a
            # header are only ever that header's own.
            if block:
                if not first:
                    choices.append(questionary.Separator(" "))
                choices.append(questionary.Separator(f"  {key}"))
            elif grouped:
                choices.append(questionary.Separator(" "))
            grouped = block

        entry.title = title(pr, *widths, indent=block)
        choices.append(entry)
    return choices


def prompt(prs: list[PullRequest]) -> questionary.Question:
    """Build the checkbox prompt, grouped by dependency and pre-ticked."""
    repo_width = max(len(f"{pr.repo}#{pr.number}") for pr in prs)
    title_width = max(24, shutil.get_terminal_size((120, 40)).columns - repo_width - 18)
    widths = (repo_width, title_width)
    rows = [(pr, choice(pr, repo_width, title_width)) for pr in prs]

    question = questionary.checkbox(
        "Approve and merge which pull requests?",
        choices=listing(rows, set(), widths, mode=0),
        style=STYLE,
        instruction="(? for keys)",
    )
    customise(question, rows, widths)
    return question


def select(prs: list[PullRequest]) -> list[PullRequest]:
    return prompt(prs).ask() or []


# MARK: Actions

Outcome = tuple[PullRequest, str, str]

# GitHub's secondary rate limits reject bursts of writes, and ask for mutating
# requests to be made one at a time with a gap between them. Every write goes
# through mutate(), which enforces that gap and widens it when rejected anyway.
MUTATION_GAP = 1.0
RETRIES = 5
RETRY_GAP = 2.0
RATE_LIMITED = re.compile(
    r"submitted too quickly|secondary rate limit|abuse detection|rate limit",
    re.IGNORECASE,
)

_pace = threading.Lock()
_last_write = 0.0
_throttled = 0


def throttled() -> int:
    """How many writes have been rejected and retried so far."""
    return _throttled


def mutate(*args: str) -> subprocess.CompletedProcess[str]:
    """Run a gh command that writes, spacing and retrying around rate limits."""
    global _last_write, _throttled

    for attempt in range(RETRIES + 1):
        with _pace:
            gap = MUTATION_GAP - (time.monotonic() - _last_write)
            if gap > 0:
                time.sleep(gap)
            result = gh(*args)
            _last_write = time.monotonic()

        if result.returncode == 0 or not RATE_LIMITED.search(result.stderr):
            return result

        if attempt < RETRIES:
            with _pace:
                _throttled += 1
            time.sleep(RETRY_GAP * 2**attempt + random.uniform(0, 1))

    return result


def process(pr: PullRequest, dry_run: bool) -> Outcome:
    """Approve then merge one pull request, returning its outcome and detail."""
    target = ["--repo", pr.repo, str(pr.number)]

    if dry_run:
        if not pr.merge_flags:
            return pr, "failed", "no merge method enabled on the repository"
        approve = "approve, " if not pr.approved else ""
        auto = " --auto" if pr.auto_merge_allowed else ""
        return pr, "dry run", f"{approve}merge{auto} {pr.merge_flags[0]}"

    if not pr.approved:
        result = mutate("pr", "review", *target, "--approve")
        if result.returncode != 0:
            return pr, "failed", f"approve: {result.stderr.strip()}"

    if not pr.merge_flags:
        return pr, "failed", "no merge method enabled on the repository"
    flag = pr.merge_flags[0]

    if pr.auto_merge_allowed:
        result = mutate("pr", "merge", *target, "--auto", flag)
        if result.returncode == 0:
            return pr, "auto-merge", flag.lstrip("-")

    result = mutate("pr", "merge", *target, flag)
    if result.returncode == 0:
        return pr, "merged", flag.lstrip("-")
    return pr, "failed", f"merge: {result.stderr.strip()}"


def run(selected: list[PullRequest], dry_run: bool) -> list[Outcome]:
    """Approve and merge in parallel, tracking progress as each one lands."""
    columns = (
        TextColumn("[progress.description]{task.description}"),
        BarColumn(),
        MofNCompleteColumn(),
        TaskProgressColumn(),
        TimeElapsedColumn(),
        TextColumn("eta"),
        TimeRemainingColumn(),
    )

    outcomes: list[Outcome] = []
    with (
        Progress(*columns, console=console) as progress,
        ThreadPoolExecutor(max_workers=4) as pool,
    ):
        task = progress.add_task("Approving and merging", total=len(selected))
        futures = [pool.submit(process, pr, dry_run) for pr in selected]
        for future in as_completed(futures):
            outcomes.append(future.result())
            failed = sum(outcome == "failed" for _, outcome, _ in outcomes)
            notes = []
            if failed:
                notes.append(f"[red]{failed} failed[/red]")
            if throttled():
                notes.append(f"[yellow]{throttled()} rate limited[/yellow]")
            progress.update(
                task,
                advance=1,
                description=" ".join(["Approving and merging", *notes]),
            )
    return outcomes


def report(outcomes: list[Outcome]) -> None:
    styles = {
        "merged": "green",
        "auto-merge": "cyan",
        "dry run": "yellow",
        "failed": "red",
    }
    table = Table(show_header=True, header_style="bold")
    table.add_column("Pull request")
    table.add_column("Outcome")
    table.add_column("Detail", overflow="fold")

    for pr, outcome, detail in outcomes:
        table.add_row(
            f"{pr.repo}#{pr.number}",
            f"[{styles.get(outcome, 'white')}]{outcome}[/]",
            detail,
        )
    console.print(table)


# MARK: Entry point


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--owner",
        action="append",
        dest="owners",
        metavar="NAME",
        help=f"user or organisation to search (default: {', '.join(OWNERS)})",
    )
    parser.add_argument(
        "-n",
        "--dry-run",
        action="store_true",
        help="show what would be approved and merged without doing it",
    )
    args = parser.parse_args()
    owners = tuple(args.owners) if args.owners else OWNERS

    with console.status("Searching for bot pull requests…") as status:
        viewer, nodes = fetch(
            owners,
            lambda count, total: status.update(
                f"Found {count} of {total} bot pull requests…"
            ),
        )
    prs = sorted(
        (build(node, viewer) for node in nodes),
        key=lambda pr: (pr.group, pr.repo, pr.number),
    )

    if not prs:
        console.print("[green]No open Renovate or Dependabot pull requests.[/green]")
        return 0

    failing = sum(pr.failing for pr in prs)
    console.print(
        f"[bold]{len(prs)}[/bold] open bot pull requests across {', '.join(owners)}"
        + (f" — [red]{failing} failing[/red]" if failing else "")
    )

    selected = select(prs)
    if not selected:
        console.print("[dim]Nothing selected.[/dim]")
        return 0

    outcomes = run(selected, args.dry_run)

    report(sorted(outcomes, key=lambda outcome: (outcome[1], outcome[0].repo)))
    return 1 if any(outcome == "failed" for _, outcome, _ in outcomes) else 0


if __name__ == "__main__":
    sys.exit(main())
