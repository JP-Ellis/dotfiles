#!/bin/sh
## Attaches to a persistent zmx session over ssh and offers to reconnect when
## the link drops.  zmx runs one daemon per session on the far side, so a dead
## connection leaves the session running and reattaching restores the terminal
## state rather than starting over.
##
## ssh reserves exit status 255 for its own transport failures, which is what
## separates a dead link from the remote side finishing on purpose.  A ctrl+\
## detach, `zmx detach`, or the session's shell exiting all report their own
## status, and those pass straight through without a prompt.
set -e

_usage() {
  cat >&2 <<'USAGE'
usage: zmx-ssh <host> [session]
       zmx-ssh <host> --reconnect

Attaches to a zmx session on <host>, defaulting to "main".

  -r, --reconnect   choose from the sessions already running on <host>
USAGE
  exit 64
}

[ $# -ge 1 ] || _usage
case $1 in
-*) _usage ;;
esac
_host=$1
shift

_pick=no
_session=main
if [ $# -gt 0 ]; then
  case $1 in
  -r | --reconnect) _pick=yes ;;
  -*) _usage ;;
  *) _session=$1 ;;
  esac
  shift
fi
[ $# -eq 0 ] || _usage

## ssh joins the remote command with spaces before the login shell sees it, so a
## session name carrying whitespace or metacharacters would be re-split there.
_check_session_name() {
  case $1 in
  '' | *[!A-Za-z0-9._-]*)
    echo "zmx-ssh: session name must be [A-Za-z0-9._-]" >&2
    exit 64
    ;;
  esac
}

## sshd runs the remote command in a non-interactive shell.  zsh sources
## ~/.profile only from .zshrc, so that shell never picks up the mise shims that
## put zmx on PATH, and `ssh host zmx` fails where an interactive login works.
## Sourcing the profile on the far side fixes it without paying for a full
## interactive startup.
##
## $HOME is meant to reach the remote shell unexpanded, hence the single quotes.
# shellcheck disable=SC2016,SC2089
_prelude='if ! command -v zmx >/dev/null 2>&1; then
  [ -r "$HOME/.profile" ] && . "$HOME/.profile"
fi
'

## A killed ssh never lets the remote application clean up, so the alternate
## screen, mouse reporting and bracketed paste stay latched on this terminal and
## scrolling starts emitting control characters at the shell.  Undo exactly
## those modes: `reset` and `tput init` would also clear the scrollback, which
## is the last thing wanted after losing a session.  zmx replays the modes and
## the screen contents when a client reattaches, so this costs nothing on
## reconnect.
_restore_terminal() {
  {
    ## Mouse reporting, in every dialect an application might have enabled.
    printf '\033[?9l\033[?1000l\033[?1001l\033[?1002l\033[?1003l'
    printf '\033[?1005l\033[?1006l\033[?1015l\033[?1016l'
    ## Focus tracking, which otherwise leaks ^[[I and ^[[O on every click.
    printf '\033[?1004l'
    printf '\033[?1049l\033[?2004l\033[?25h\033[0m'
  } >/dev/tty 2>/dev/null || return 0
  stty sane </dev/tty >/dev/null 2>&1 || :
}

## `zmx ls` reports tab-separated key=value pairs.  Names alone are not much use
## after a crash, so the picker shows how long a session has been up, whether
## anything is still attached, and where it started.
_format_sessions() {
  awk -F'\t' -v now="$(date +%s)" '
    function age(t,   d) {
      if (t == "") return "?"
      d = now - t
      if (d < 60)    return d "s"
      if (d < 3600)  return int(d / 60) "m"
      if (d < 86400) return int(d / 3600) "h"
      return int(d / 86400) "d"
    }
    {
      name = ""; clients = ""; created = ""; dir = ""
      for (i = 1; i <= NF; i++) {
        ## The first field carries the leading indent, so trim before locating
        ## the separator or the key comes out short by however much was cut.
        k = $i
        sub(/^[ \t]+/, "", k)
        eq = index(k, "=")
        if (eq == 0) continue
        v = substr(k, eq + 1)
        k = substr(k, 1, eq - 1)
        if (k == "name")            name = v
        else if (k == "clients")    clients = v
        else if (k == "created")    created = v
        else if (k == "start_dir")  dir = v
      }
      if (name != "")
        printf "%s\t%s\t%s attached\t%s\n", name, age(created), clients, dir
    }
  '
}

## Every remote zmx call has to go through the prelude, not just the attach.
## ~/.profile sets TMPDIR, and zmx derives its socket directory from it, so a
## call made without the profile looks in the wrong place and reports that no
## sessions exist while the attach happily talks to them.
_choose_session() {
  # shellcheck disable=SC2029
  _raw=$(ssh "$_host" "${_prelude}zmx ls" 2>/dev/null) || {
    echo "zmx-ssh: could not list sessions on $_host" >&2
    exit 1
  }

  ## `zmx ls` says "no sessions found in ..." on stdout and still exits 0, but
  ## that line carries no name= field and the formatter drops it.
  _rows=$(printf '%s\n' "$_raw" | _format_sessions)
  if [ -z "$_rows" ]; then
    echo "zmx-ssh: no sessions running on $_host" >&2
    exit 1
  fi

  if command -v fzf >/dev/null 2>&1; then
    ## Passed through the environment because fzf shell-quotes {1} itself,
    ## which would collide with another layer of quoting in --preview.
    # shellcheck disable=SC2090
    export ZMX_PRELUDE="$_prelude"
    _choice=$(printf '%s\n' "$_rows" | fzf \
      --delimiter='\t' --with-nth=1,2,3,4 \
      --header="zmx sessions on $_host" \
      --preview="ssh $_host \"\$ZMX_PRELUDE zmx history {1} 2>/dev/null | tail -n 200\"" \
      --preview-window='down,60%,wrap') || exit 130
  else
    ## POSIX sh has no `select`, and the fallback only has to be usable.
    printf '%s\n' "$_rows" | awk -F'\t' '{ printf "%3d) %-20s %-6s %-12s %s\n", NR, $1, $2, $3, $4 }' >&2
    printf 'session number: ' >/dev/tty
    read -r _n </dev/tty || exit 130
    _choice=$(printf '%s\n' "$_rows" | sed -n "${_n}p")
    [ -n "$_choice" ] || {
      echo "zmx-ssh: no such session" >&2
      exit 1
    }
  fi

  _session=${_choice%%	*}
}

if [ "$_pick" = yes ]; then
  _choose_session
fi
_check_session_name "$_session"

while :; do
  ## set -e would abort here, and reading the status is the whole point.
  _status=0
  ssh -t "$_host" "${_prelude}exec zmx attach $_session" || _status=$?

  ## The terminal is left in whatever state the remote application had it in, so
  ## restore it before anything else writes to the screen.
  _restore_terminal

  [ "$_status" -eq 255 ] || exit "$_status"

  echo "zmx-ssh: connection to $_host lost" >&2

  ## stdin belongs to the ssh session that just died, so the prompt reads the
  ## terminal directly.  No tty means nobody can answer, so stop retrying.
  printf 'reconnect to session "%s"? [Y/n] ' "$_session" >/dev/tty 2>/dev/null || exit 255
  read -r _reply </dev/tty 2>/dev/null || exit 255

  case $_reply in
  [Nn]*) exit 255 ;;
  esac
done
